# Mode the application runs in. Allowed values: locale, production
MODE=locale

# Django secret key used for cryptographic signing.
# Ensure to use a strong random value in production.
SECRET_KEY=

# Public URL of your application that is accessible from the outside
APP_URL=https://yourdomain.com

# Telegram Login credentials
# https://core.telegram.org/bots/telegram-login#tldr
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=

# Telegram bot token of the platform bot, issued by @BotFather
# https://core.telegram.org/bots/features#botfather
PLATFORM_BOT_TELEGRAM_TOKEN=

# Token the backend uses to send requests to the platform bot
PLATFORM_BOT_API_TOKEN=platform_bot_token

# Token the platform bot uses to send requests to the backend
BACKEND_PLATFORM_BOT_API_TOKEN=backend_platform_bot_token

# Database configuration
DATABASE_NAME=constructor_telegram_bots
DATABASE_USER=exg1o
DATABASE_PASSWORD=password

# Docker socket path
DOCKER_SOCKET=/var/run/docker.sock

# Public HTTP port exposed by Nginx on the host machine
HTTP_PORT=8000
